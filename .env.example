# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
# Password for the Postgres role. REQUIRED — compose refuses to start without
# it. Generate: openssl rand -base64 24
POSTGRES_PASSWORD="change-me-generate-a-long-random-password"
# Local dev: compose publishes Postgres on 127.0.0.1:5433 (5432 inside Docker).
# The password below must match POSTGRES_PASSWORD above.
DATABASE_URL="postgresql://birkityt:change-me-generate-a-long-random-password@localhost:5433/birkityt?schema=public"

# --- Domain & HTTPS (Let's Encrypt via Caddy) ---
# Your real domain. DNS A/AAAA record must point to this server, ports 80+443 open.
# Caddy auto-issues a Let's Encrypt certificate for it.
# Use "localhost" for local testing (Caddy serves a self-signed cert).
DOMAIN="birkityt.ru"
# Email for the Let's Encrypt account (expiry notices). Recommended.
ACME_EMAIL="admin@birkityt.ru"

# --- Auth.js ---
# Generate: openssl rand -base64 32
AUTH_SECRET="change-me-please-generate-a-long-random-secret"
# In production set this to your HTTPS URL, e.g. https://birkityt.ru
AUTH_URL="https://birkityt.ru"

# --- First admin (used by `npm run db:seed`) ---
ADMIN_EMAIL="admin@birkityt.ru"
ADMIN_PASSWORD="change-me-please"

# --- SMTP (email notifications, stage 2) ---
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Birkityt <no-reply@birkityt.ru>"
MAIL_TO="orders@birkityt.ru"

# --- MAX bot (уведомления о заявках и об ошибках бэкапа) ---
# Токен от @MasterBot в MAX. См. docs/notifications.md.
MAX_BOT_TOKEN=""
# Идентификатор чата, куда слать. Узнать: bash scripts/max-chat-id.sh
MAX_CHAT_ID=""

# --- Analytics ---
# Yandex.Metrika counter id. Leave empty to disable analytics entirely
# (no counter, no cookie banner).
# NOTE: this is a NEXT_PUBLIC_* variable — it is baked into the client bundle
# at `next build`, not read at runtime. docker-compose passes it as a build
# arg, so changing it requires rebuilding the web image:
#   docker compose build web && docker compose up -d web
NEXT_PUBLIC_YANDEX_METRIKA_ID="111863215"

# --- Backups ---
# Where scripts/backup.sh writes dumps, and how many daily copies to keep.
BACKUP_DIR="./backups"
BACKUP_KEEP_DAYS="14"

# --- Uploads ---
UPLOAD_DIR="./uploads"

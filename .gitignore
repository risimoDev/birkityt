# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# production
/build
/dist

# prisma
/prisma/*.db

# uploads (user content lives in a mounted volume)
/uploads/*
!/uploads/.gitkeep

# backups (database dumps and uploaded files — never commit)
/backups/

# env
.env
.env*.local

# misc
.DS_Store
*.pem
# ...except the public CA bundle the build needs. Only public certificates
# belong in certs/ — private keys must never be committed.
!certs/*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.idea
